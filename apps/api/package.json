{
  "name": "@tusofertas/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k -n types,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env --env-file-if-exists=.env dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "npm run build && node --test test/*.test.cjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "npm run build && node --env-file-if-exists=../../.env --env-file-if-exists=.env dist/seed/main.js",
    "test:db": "node scripts/test-db.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/throttler": "6.7.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.6",
    "concurrently": "9.2.4",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3"
  }
}
