NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# El rewrite de Next reenvía /api desde 127.0.0.1: confiar en loopback para ver la IP real.
TRUST_PROXY=loopback
# En Vercel: TRUST_PROXY=vercel (un salto; Vercel reemplaza X-Forwarded-For, ADR 0010).
# DATABASE_URL se carga desde ../../.env.
# Auth (P1-03). El secreto de ejemplo solo sirve en desarrollo: producción lo rechaza.
# Generar uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=solo-desarrollo-cambiar-por-un-valor-aleatorio-largo
JWT_ISSUER=tusofertas-api
JWT_AUDIENCE=tusofertas-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
# Precios (P2-01). Días tras los cuales una observación se muestra como desactualizada.
PRICE_MAX_AGE_DAYS=7
# Fuentes preferidas ante igual fecha observada, separadas por coma. Vacío = orden alfabético.
PRICE_SOURCE_PRECEDENCE=
# Planificador (P5-01, ADR 0013). Días máximos de un plan, fechas de compra evaluadas,
# sucursales que llegan al optimizador y ofertas por necesidad y sucursal.
PLANNER_MAX_HORIZON_DAYS=28
PLANNER_MAX_CANDIDATE_DATES=7
PLANNER_MAX_CANDIDATE_STORES=8
PLANNER_MAX_OFFERS_PER_STORE=2
# Optimizador (P5-02, ADR 0014): combinaciones que evalúa la búsqueda exacta antes del método aproximado.
PLANNER_MAX_COMBINATIONS=100000
# Importación manual (P7-01, P7-02; `npm.cmd run import`). Hosts permitidos para --url, separados por coma:
# nunca se descarga una URL fuera de esta lista. IMPORT_ALLOW_REMOTE=true habilita importar a una base no local.
IMPORT_ALLOWED_HOSTS=
# Jobs (P8-01, ADR 0020; `npm.cmd run worker` y `npm.cmd run jobs`). REDIS_URL se carga desde ../../.env.
# El API HTTP no usa Redis. Prefijo de las claves, intentos por job y primera espera entre intentos (se duplica).
JOBS_PREFIX=tusofertas
JOBS_ATTEMPTS=3
JOBS_BACKOFF_MS=30000
# Jobs simultáneos por cola; tiempo sin renovar el bloqueo tras el cual un job se da por caído y se retoma.
JOBS_IMPORT_CONCURRENCY=1
JOBS_PLAN_CONCURRENCY=2
JOBS_LOCK_DURATION_MS=60000
JOBS_STALLED_INTERVAL_MS=30000
# Único directorio (ruta absoluta) desde el que un job lee archivos de --provider=jsonl. Vacío = no se aceptan.
IMPORT_FILES_DIR=
