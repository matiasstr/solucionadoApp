NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# El rewrite de Next reenvía /api desde 127.0.0.1: confiar en loopback para ver la IP real.
TRUST_PROXY=loopback
# DATABASE_URL se carga desde ../../.env.
# Auth (P1-03). El secreto de ejemplo solo sirve en desarrollo: producción lo rechaza.
# Generar uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=solo-desarrollo-cambiar-por-un-valor-aleatorio-largo
JWT_ISSUER=tusofertas-api
JWT_AUDIENCE=tusofertas-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
# Precios (P2-01). Días tras los cuales una observación se muestra como desactualizada.
PRICE_MAX_AGE_DAYS=7
# Fuentes preferidas ante igual fecha observada, separadas por coma. Vacío = orden alfabético.
PRICE_SOURCE_PRECEDENCE=
